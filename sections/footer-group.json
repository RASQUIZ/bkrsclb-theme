          "settings": {
            "custom_liquid": "<div class=\"rf-wrap\">\n  <a class=\"rf-link h2\" href=\"https://razfresco.com\" aria-label=\"Visit RAZFRESCO.COM\">RAZFRESCO.COM <span class=\"rf-arw\" aria-hidden=\"true\">↗</span></a>\n</div>\n\n<style>\n  .rf-wrap{ display:flex; align-items:center; justify-content:flex-end; }\n\n  /* the h2 class supplies size / family / weight, so the link matches the\n     email field exactly and keeps matching if that preset ever changes */\n  .rf-link{\n    display:inline-flex; align-items:center; gap:.3em;\n    color:currentColor; text-decoration:none;\n    letter-spacing:normal; text-transform:none;\n    white-space:nowrap; margin:0; padding:0;\n    transition:color .18s ease;\n  }\n  .rf-arw{ font-size:.8em; line-height:1; transition:transform .18s ease; }\n  .rf-link:hover, .rf-link:focus-visible{ color:#0F7B43; }\n  .rf-link:hover .rf-arw, .rf-link:focus-visible .rf-arw{ transform:translateX(3px); }\n  .rf-link:focus-visible{ outline:2px solid #0F7B43; outline-offset:4px; }\n\n  /* mobile: full width, centred under the email field. The 9vw cap only\n     bites below ~356px wide, so the size match holds on real phones. */\n  @media (max-width:749px){\n    .section-content-wrapper > :has(> .rf-wrap){ width:100%; }\n    .rf-wrap{ justify-content:center; }\n    .rf-link{ font-size:min(var(--font-h2--size, 2rem), 9vw); }\n  }\n  @media (prefers-reduced-motion:reduce){\n    .rf-link, .rf-arw{ transition:none; }\n  }\n</style>"
